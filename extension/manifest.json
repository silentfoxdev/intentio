{
  "manifest_version": 3,
  "name": "Intentio",
  "version": "2.1.0",
  "description": "Block distractions and choose where to focus your attention.",
  "author": "Intentio",
  "minimum_chrome_version": "121",
  "permissions": ["storage", "tabs", "declarativeNetRequest", "alarms"],
  "host_permissions": ["http://*/*", "https://*/*"],
  "content_scripts": [{
    "matches": ["https://*/*"],
    "js": ["google-search.js"],
    "css": ["google-search.css"],
    "run_at": "document_start"
  }],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "Intentio",
    "default_icon": { "48": "icons/icon48.png", "96": "icons/icon96.png" }
  },
  "options_ui": { "page": "options.html", "open_in_tab": true },
  "web_accessible_resources": [{ "resources": ["blocked.html", "blocked.css", "blocked.js", "core.js", "icons/icon48.png", "icons/icon.svg"], "matches": ["http://*/*", "https://*/*"] }],
  "icons": { "48": "icons/icon48.png", "96": "icons/icon96.png" }
}
